# Copy to .env and source it, or pass inline. All optional.

# --- Server / deploy ---
HOST=0.0.0.0
PORT=8787
# AUTH_TOKEN protects every route except /health and the static shell. Leave
# empty for localhost dev; ALWAYS set it when exposing a public URL.
#   openssl rand -hex 24
AUTH_TOKEN=

# --- Embeddings ---
# local  = transformers.js MiniLM (semantic, downloads ~23MB once)
# hashing = pure-JS lexical, no network (fallback / CI)
# jina   = Jina Embeddings v3 (multilingual, strong) — needs JINA_API_KEY
EMBED_PROVIDER=local
# JINA_API_KEY=jina_...        # also raises s.jina.ai search limits

# --- Reranking (optional, big precision boost) ---
# jina = Jina Reranker v2 multilingual (over-fetch then reorder). Needs JINA_API_KEY.
# RERANK=jina

# --- Web search (/research) ---
# tavily | brave | jina(s.jina.ai)
# SEARCH_PROVIDER=tavily
# TAVILY_API_KEY=tvly-...
# BRAVE_API_KEY=...

# --- Server-side LLM (/ask + SUMMARY=llm) ---
# Any OpenAI-compatible endpoint (Groq / OpenRouter free tiers, local).
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_...
# LLM_MODEL=llama-3.3-70b-versatile

# --- Storage ---
# ndjson = zero-dep file (single machine)
# libsql = libSQL/Turso (local file OR remote, multi-device)
STORE=ndjson
# Local file DB:
# STORE=libsql
# LIBSQL_URL=file:data/store.db
# Remote Turso (multi-device): create a DB at https://turso.tech (free tier)
# STORE=libsql
# LIBSQL_URL=libsql://your-db.turso.io
# LIBSQL_AUTH_TOKEN=your-token

# --- Daily digest delivery ---
# console | file | ntfy | resend  (comma-separated for multiple)
NOTIFY=console
# ntfy (keyless push): pick any hard-to-guess topic, subscribe in the ntfy app
# NTFY_TOPIC=my-second-brain-7x9k2
# Resend email:
# RESEND_API_KEY=re_...
# RESEND_TO=you@example.com
# RESEND_FROM=Second Brain <onboarding@resend.dev>

# How many hours back the digest covers
DIGEST_HOURS=24

# --- Digest summary quality ---
# extractive (default) = keyless sentence extraction, offline
# llm                  = fluent summary via an OpenAI-compatible endpoint
#                        (falls back to extractive on any error)
SUMMARY=extractive
# Free OpenAI-compatible options:
#   Groq:       LLM_BASE_URL=https://api.groq.com/openai/v1  LLM_MODEL=llama-3.3-70b-versatile
#   OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1    LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
# SUMMARY=llm
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_...
# LLM_MODEL=llama-3.3-70b-versatile
